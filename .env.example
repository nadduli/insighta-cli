# Backend base URL (no trailing slash). Required.
INSIGHTA_BACKEND_URL=http://localhost:8000

# GitHub OAuth client ID for the CLI app.
# Must be the *CLI* app (PKCE), not the web app — the redirect URIs differ.
# Public value, not a secret.
INSIGHTA_GITHUB_CLIENT_ID=your_cli_client_id_here

# Loopback port for the OAuth callback server. Must match the redirect URI
# registered on the GitHub CLI OAuth app (http://127.0.0.1:<port>/callback)
# AND the backend's GITHUB_CLI_CALLBACK_PORT setting.
INSIGHTA_CALLBACK_PORT=51420
